{
  "$schema": "./rice.schema.json",

  "ipc_url": "ws://127.0.0.1:6123",
  "bar_height": 34,

  "mics": ["hyperx", "snowball"],
  "outputs": ["hyperx", "vg270", "airpods"],
  "clickthrough_apps": ["league of legends", "valorant"],
  "hide_bar_on_fullscreen": false,

  "clips": {
    "upload": true,
    "host": "catbox",
    "litterbox_time": "72h",
    "transcode": true,
    "cq": 26,
    "discord_when_focused": ["league of legends"]
  },

  "launcher": {
    "index_store_apps": false,
    "index_files": true,
    "file_skip": [
      ":\\windows",
      ":\\program files",
      ":\\program files (x86)",
      ":\\programdata",
      "\\node_modules",
      "\\.git",
      "\\.rustup",
      "\\.cargo\\registry",
      "\\.nuget",
      "\\.gradle",
      "\\.m2",
      "\\.vscode\\extensions",
      "\\.vscode-insiders\\extensions",
      "\\__pycache__",
      "\\.venv",
      "\\target\\debug",
      "\\target\\release",
      "\\appdata\\local\\temp",
      "\\appdata\\local\\packages",
      "\\appdata\\local\\microsoft",
      "\\appdata\\locallow",
      "\\$recycle.bin",
      "\\system volume information"
    ]
  },

  "animation": {
    "spring_stiffness": 300.0,
    "spring_damping": 23.0,
    "pill_ease": 15.0,
    "text_ease": 14.0,
    "workspace_ease": 16.0,
    "notification_hold_secs": 4.0,
    "panel_timeout_secs": 6.0,
    "spectrum_fps": 30
  }
}
